# ── Mouride SaaS Platform — Variables d'environnement ──────
# Copier ce fichier en .env et renseigner les valeurs

# Base de données PostgreSQL
DB_PASSWORD=mouride_secret_changez_en_production

# Redis
REDIS_PASSWORD=redis_mouride_changez_en_production

# RabbitMQ
RABBITMQ_PASSWORD=rabbit_mouride_changez_en_production

# JWT — OBLIGATOIRE : générer une clé aléatoire de 256 bits minimum
# Exemple : openssl rand -base64 64
JWT_SECRET=mouride-jwt-secret-min-256-bits-CHANGEZ-EN-PRODUCTION

# MinIO (Stockage fichiers)
MINIO_ACCESS_KEY=minio_mouride
MINIO_SECRET_KEY=minio_secret_changez_en_production

# Email SMTP (Gmail exemple)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-application

# Mobile Money (optionnel)
WAVE_API_KEY=
ORANGE_MONEY_API_KEY=
FREE_MONEY_API_KEY=

# SMS Twilio (optionnel)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Business API (optionnel)
WHATSAPP_API_KEY=

# Anthropic API (chatbot religieux IA — optionnel)
ANTHROPIC_API_KEY=
